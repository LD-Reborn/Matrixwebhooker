# --- Matrix account (the bot) ---
MATRIX_HOME_SERVER=https://matrix.yourdomain.tld
MATRIX_USER=@webhook_bot:matrix.yourdomain.tld
MATRIX_PASSWORD=change-me

# --- Webhook auth ---
# Required in the X-API-Key header (or `Authorization: Bearer <key>`) on /webhook.
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
API_KEY=change-me

# --- Target room (optional) ---
# Leave MATRIX_ROOM_ID empty to auto-create a private room and save its ID to .room_id.
MATRIX_ROOM_ID=
# Matrix user to invite into the auto-created room:
MATRIX_INVITE_USER=@youruser:matrix.yourdomain.tld
# MATRIX_ROOM_NAME=Webhooker Alerts

# --- HTTP server ---
HOST=0.0.0.0
PORT=8080
