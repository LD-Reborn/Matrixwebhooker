# --- Matrix homeserver (shared by all bots) ---
MATRIX_HOME_SERVER=https://matrix.yourdomain.tld

# Invited into each bot's auto-created room (used when a bot has no room_id
# yet). Leave empty to disable auto-creation of rooms.
MATRIX_INVITE_USER=@youruser:matrix.yourdomain.tld

# --- HTTP server ---
HOST=0.0.0.0
PORT=8080

# --- Per-bot credentials ---
# Each bot (Matrix login + its own API key + its own room) lives in bots.json
# next to this file — see bots.example.json.

# --- Runtime state ---
# Where per-bot token/room caches live. Defaults to the app directory;
# the Docker setup uses /app/state (a named volume).
# MATRIX_STATE_DIR=

# --- OpenCode server (trigger/call actions) ---
# The headless OpenCode instance actions run on: `opencode serve --port 4096`
# (the systemd deploy script sets this unit up and writes the password here).
OPENCODE_SERVER_URL=http://127.0.0.1:4096
OPENCODE_SERVER_PASSWORD=change-me

# --- MCP server (mcp_server.py) ---
# Which bot the tools use when you don't pass one.
# MCP_BOT=grafana_bot
# Base URL of the HTTP server that serves wait_for_reply (owns the triggers).
# MATRIX_WEBHOOKER_URL=http://localhost:8080

# --- Voice calls (optional; see README "Voice calls") ---
# OpenAI-compatible gateway serving STT (whisper) and TTS. The token can be
# part of the path (…/token/<token>) or you can use a plain base URL.
#VOICE_BASE_URL=https://ai.yourdomain.tld/token/<token>
#VOICE_STT_MODEL=whisper-large-v3-turbo
#VOICE_TTS_MODEL=qwen3-tts-customvoice
#VOICE_TTS_VOICE=            # empty -> the gateway's default voice
#VOICE_TTS_INSTRUCTION=Professionell, deutsch.
#                             # natural-language style control for qwen3-tts
#VOICE_CACHE_DIR=            # fixed phrases (greeting, "one moment") are cached
#                             # here; default <state dir>/voice-cache
#VOICE_LANGUAGE=de           # ISO code for both directions (empty -> whisper auto)
